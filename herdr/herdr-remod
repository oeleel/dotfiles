#!/bin/bash
# Rebuild Leo's Herdr clones of two shipped mods, install his accounts panel, and build his layout.
#
# Herdr replaces its shipped mods and layouts on every update, and it never updates a clone.
# This script makes the clones follow the shipped files. Each clone is the shipped mod, renamed
# as `mod.clone` renames it, with <clone>.patch applied and every file in <clone>/ added:
#   agents-menu, from `agents`: the right-click menu and the session-name hover.
#   tabs-leo, from `tabs`: the Accounts button in the tab bar. Its patch also imports core.js,
#     tab.js, accounts.js and resume.js from accounts/, which go in as they are.
# It also installs Leo's own `accounts` mod from accounts/ (without the fixtures and tests).
# The main-leo layout is the shipped `main` layout with the agents and tabs blocks pointed at
# the installed clones and one accounts block: last in the right-side panel-body stack, which
# the tab bar button opens, or after the agents block in the sidebar while tabs-leo is not
# installed, so the panel stays reachable. The layout keeps these after every Herdr update.
#
# The launchd job dev.leolee.herdr-remod runs it when Herdr rewrites the shipped files or a
# source file here changes. It writes nothing when the result is already installed. The
# four parts (the two clones, the accounts mod, the layout) stand alone: a part that fails
# keeps its installed copy and posts a notification, the other parts still go in, and the
# run exits 1. The layout names only mods that are installed.
set -euo pipefail

readonly APP_HOME="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
readonly SOURCE_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly AGENTS_SHIPPED_MOD="agents"
readonly AGENTS_MOD="agents-menu"
readonly TABS_SHIPPED_MOD="tabs"
readonly TABS_MOD="tabs-leo"
readonly ACCOUNTS_SOURCE_DIR="$SOURCE_DIR/accounts"
readonly ACCOUNTS_MOD="accounts"
# The accounts modules the tabs-leo patch imports.
readonly TABS_ACCOUNTS_MODULES=(core.js tab.js accounts.js resume.js)
# Only the tests read these; the app never does.
readonly ACCOUNTS_TEST_ONLY=(fixtures '*.test.*')
readonly SHIPPED_LAYOUT="main"
readonly LAYOUT="main-leo"
# With tabs-leo installed, the accounts block goes last in this stack.
readonly PANEL_STACK="panel-body"
readonly PANEL_ACCOUNTS_BLOCK='{"id":"accounts","type":"block","content":{"mod":"accounts"}}'
# Without tabs-leo, it goes right after the agents block in this column.
readonly SIDEBAR_COLUMN="sidebar-lists"
readonly SIDEBAR_ACCOUNTS_BLOCK='{"id":"accounts","type":"block","size":{"weight":0.6},"min":110,"content":{"mod":"accounts"}}'
# Herdr writes these into every mod folder; they are not part of the mod.
readonly APP_WRITTEN=(gpui-kit.d.ts jsconfig.json)
# Herdr rewrites several shipped files in a row; wait until it is done.
readonly SETTLE_SECONDS="${HERDR_REMOD_SETTLE_SECONDS:-0}"

export PATH="$HOME/.local/bin:/usr/bin:/bin"

failed=false
# One part failed: say so now, and let the other parts go on.
warn() {
  echo "herdr-remod: $1" >&2
  osascript -e "display notification \"$1\" with title \"Herdr panel rebuild failed\"" >/dev/null 2>&1 || true
  failed=true
}

sleep "$SETTLE_SECONDS"

shipped_layout_file="$APP_HOME/layouts/$SHIPPED_LAYOUT.json"
accounts_dir="$APP_HOME/mods/$ACCOUNTS_MOD"
layout_file="$APP_HOME/layouts/$LAYOUT.json"

build_dir="$(mktemp -d)"
trap 'rm -rf "$build_dir"' EXIT
built_accounts_dir="$build_dir/$ACCOUNTS_MOD"
built_layout_file="$build_dir/$LAYOUT.json"

excludes=()
for name in "${APP_WRITTEN[@]}"; do excludes+=(--exclude "$name"); done
accounts_excludes=("${excludes[@]}")
for name in "${ACCOUNTS_TEST_ONLY[@]}"; do accounts_excludes+=(--exclude "$name"); done
diff_excludes=()
for name in "${APP_WRITTEN[@]}"; do diff_excludes+=(-x "$name"); done
tabs_accounts_files=()
for name in "${TABS_ACCOUNTS_MODULES[@]}"; do tabs_accounts_files+=("$ACCOUNTS_SOURCE_DIR/$name"); done

# Installs a built mod unless the installed one is already current. A mod that fails
# herdr-app check keeps its installed copy.
install_mod() {
  local built="$1" target="$2" name
  name="$(basename "$target")"
  diff -rq "${diff_excludes[@]}" "$built" "$target" >/dev/null 2>&1 && return
  if ! herdr-app check "$built" >/dev/null 2>"$build_dir/check.log"; then
    warn "the rebuilt $name mod does not pass herdr-app check: $(tr '\n' ' ' < "$build_dir/check.log")"
    return
  fi
  # rsync replaces each file in one step, so Herdr never reads a half-written file.
  mkdir -p "$target"
  rsync -a --delete "${excludes[@]}" "$built/" "$target/"
  echo "herdr-remod: rebuilt mods/$name"
}

# A clone: the shipped mod's files, renamed as `mod.clone` renames them, then <clone>.patch,
# then every file in <clone>/ and the extra files given, as they are.
build_clone() {
  local shipped="$1" clone="$2"
  shift 2
  local shipped_dir="$APP_HOME/mods/$shipped" patch_file="$SOURCE_DIR/$clone.patch"
  local modules_dir="$SOURCE_DIR/$clone" built="$build_dir/$clone" extra script
  [ -f "$shipped_dir/main.js" ] || { warn "shipped mod not found: $shipped_dir/main.js"; return; }
  [ -f "$patch_file" ] || { warn "patch not found: $patch_file"; return; }
  [ -d "$modules_dir" ] || { warn "patch modules not found: $modules_dir"; return; }
  for extra in "$@"; do
    [ -f "$extra" ] || { warn "patch module not found: $extra"; return; }
  done
  rsync -a "${excludes[@]}" "$shipped_dir/" "$built/"
  for script in "$built"/*.js; do
    sed -e "s#mods/$shipped/#mods/$clone/#g" -e "s#mod: \"$shipped\"#mod: \"$clone\"#g" "$script" > "$script.renamed"
    mv "$script.renamed" "$script"
  done
  if ! patch --silent --forward --directory "$built" --strip 1 --reject-file - --input "$patch_file"; then
    warn "$clone.patch does not apply to the shipped $shipped mod; update the patch"
    return
  fi
  rm -f "${built:?}"/*.orig
  rsync -a --exclude ".*" "$modules_dir/" "$built/"
  if [ $# -gt 0 ]; then cp "$@" "$built/"; fi
  install_mod "$built" "$APP_HOME/mods/$clone"
}

# The accounts mod: Leo's own files as they are.
build_accounts() {
  [ -f "$ACCOUNTS_SOURCE_DIR/main.js" ] || { warn "accounts mod not found: $ACCOUNTS_SOURCE_DIR/main.js"; return; }
  rsync -a "${accounts_excludes[@]}" "$ACCOUNTS_SOURCE_DIR/" "$built_accounts_dir/"
  install_mod "$built_accounts_dir" "$accounts_dir"
}

# Prints how many objects in a layout file ($3) match a jq condition ($1) on $name ($2).
count_in_layout() {
  jq --arg name "$2" "[.. | objects | select($1)] | length" "$3"
}

# The layout: the shipped one, built after the mods so it names only installed mods. Each
# block stays on its shipped mod until the clone is installed. The accounts block goes into
# panel-body once accounts and tabs-leo are installed, and into the sidebar once only
# accounts is.
build_layout() {
  [ -f "$shipped_layout_file" ] || { warn "shipped layout not found: $shipped_layout_file"; return; }
  if ! jq empty "$shipped_layout_file" 2>"$build_dir/jq.log"; then
    warn "the shipped $SHIPPED_LAYOUT layout is not valid JSON: $(tr '\n' ' ' < "$build_dir/jq.log")"
    return
  fi
  local found holds where agents_mod="$AGENTS_SHIPPED_MOD" tabs_mod="$TABS_SHIPPED_MOD" accounts_in=""
  found="$(count_in_layout '.content.mod? == $name' "$AGENTS_SHIPPED_MOD" "$shipped_layout_file")"
  if [ "$found" != "1" ]; then
    warn "expected 1 $AGENTS_SHIPPED_MOD block in the shipped $SHIPPED_LAYOUT layout, found $found"
    return
  fi
  found="$(count_in_layout '.content.mod? == $name' "$TABS_SHIPPED_MOD" "$shipped_layout_file")"
  if [ "$found" != "1" ]; then
    holds="$(jq -r '[.. | objects | select(.type == "block") | .content.mod? // empty] | unique | join(", ")' "$shipped_layout_file")"
    warn "expected 1 $TABS_SHIPPED_MOD block in the shipped $SHIPPED_LAYOUT layout, found $found (blocks: ${holds:-none})"
    return
  fi
  found="$(count_in_layout '.id == $name and .type == "stack"' "$PANEL_STACK" "$shipped_layout_file")"
  if [ "$found" != "1" ]; then
    holds="$(jq -r '[.. | objects | select(.type == "stack") | .id] | join(", ")' "$shipped_layout_file")"
    warn "expected 1 $PANEL_STACK stack in the shipped $SHIPPED_LAYOUT layout, found $found (stacks: ${holds:-none})"
    return
  fi

  if [ -f "$APP_HOME/mods/$AGENTS_MOD/main.js" ]; then agents_mod="$AGENTS_MOD"; fi
  if [ -f "$APP_HOME/mods/$TABS_MOD/main.js" ]; then tabs_mod="$TABS_MOD"; fi
  if [ -f "$accounts_dir/main.js" ]; then
    # The tab bar button opens the panel; without the button, the sidebar keeps it reachable.
    if [ "$tabs_mod" = "$TABS_MOD" ]; then accounts_in="$PANEL_STACK"; else accounts_in="$SIDEBAR_COLUMN"; fi
  fi
  # jq prints the 2-space format Herdr ships, and the same input always gives the same
  # bytes, so `cmp` below still finds a current layout current.
  if ! jq --arg agents "$AGENTS_SHIPPED_MOD" --arg agents_mod "$agents_mod" \
    --arg tabs "$TABS_SHIPPED_MOD" --arg tabs_mod "$tabs_mod" \
    --arg accounts_in "$accounts_in" --arg panel "$PANEL_STACK" --arg sidebar "$SIDEBAR_COLUMN" \
    --argjson panel_block "$PANEL_ACCOUNTS_BLOCK" --argjson sidebar_block "$SIDEBAR_ACCOUNTS_BLOCK" '
    (.. | objects | select(.content.mod? == $agents) | .content.mod) = $agents_mod
    | (.. | objects | select(.content.mod? == $tabs) | .content.mod) = $tabs_mod
    | if $accounts_in == $panel then
        (.. | objects | select(.id == $panel and .type == "stack") | .children) += [$panel_block]
      elif $accounts_in == $sidebar then
        (.. | objects | select(.id == $sidebar) | .children) |=
          [.[] | ., (select(.content.mod? == $agents_mod) | $sidebar_block)]
      else . end
  ' "$shipped_layout_file" > "$built_layout_file" 2>"$build_dir/jq.log"; then
    warn "jq could not build the $LAYOUT layout: $(tr '\n' ' ' < "$build_dir/jq.log")"
    return
  fi
  if [ -n "$accounts_in" ]; then
    found="$(count_in_layout '.content.mod? == $name' "$ACCOUNTS_MOD" "$built_layout_file")"
    if [ "$found" != "1" ]; then
      where="in $accounts_in"
      if [ "$accounts_in" = "$SIDEBAR_COLUMN" ]; then where="after the $agents_mod block in $SIDEBAR_COLUMN"; fi
      holds="$(jq -r --arg id "$accounts_in" \
        '[.. | objects | select(.id == $id) | .children[]? | .content.mod? // .id] | join(", ")' \
        "$built_layout_file")"
      warn "expected 1 $ACCOUNTS_MOD block $where of the $LAYOUT layout, found $found ($accounts_in holds: ${holds:-no blocks})"
      return
    fi
  fi
  cmp -s "$built_layout_file" "$layout_file" && return
  # mv replaces the file in one step, so Herdr never reads a half-written file.
  cp "$built_layout_file" "$layout_file.new"
  mv "$layout_file.new" "$layout_file"
  echo "herdr-remod: rebuilt layouts/$LAYOUT.json"
}

build_clone "$AGENTS_SHIPPED_MOD" "$AGENTS_MOD"
build_clone "$TABS_SHIPPED_MOD" "$TABS_MOD" "${tabs_accounts_files[@]}"
build_accounts
build_layout
if $failed; then exit 1; fi
