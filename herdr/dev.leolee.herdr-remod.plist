<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: cp this file to ~/Library/LaunchAgents/, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.leolee.herdr-remod.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.leolee.herdr-remod</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/leolee/dotfiles/herdr/herdr-remod</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERDR_REMOD_SETTLE_SECONDS</key>
    <string>3</string>
  </dict>
  <!-- Herdr rewrites the shipped files when it starts after an update. The accounts and
       tabs-leo folders catch a file that is added or removed; each file catches an edit in
       place. -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/leolee/.config/herdr-app/installed.json</string>
    <string>/Users/leolee/.config/herdr-app/mods/agents</string>
    <string>/Users/leolee/.config/herdr-app/mods/agents/main.js</string>
    <string>/Users/leolee/.config/herdr-app/mods/tabs</string>
    <string>/Users/leolee/.config/herdr-app/mods/tabs/main.js</string>
    <string>/Users/leolee/.config/herdr-app/layouts/main.json</string>
    <string>/Users/leolee/dotfiles/herdr/agents-menu.patch</string>
    <string>/Users/leolee/dotfiles/herdr/agents-menu/sessions.js</string>
    <string>/Users/leolee/dotfiles/herdr/tabs-leo.patch</string>
    <string>/Users/leolee/dotfiles/herdr/tabs-leo</string>
    <string>/Users/leolee/dotfiles/herdr/tabs-leo/account.svg</string>
    <string>/Users/leolee/dotfiles/herdr/accounts</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/mod.json</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/config.json</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/main.js</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/accounts.js</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/resume.js</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/core.js</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/tab.js</string>
    <string>/Users/leolee/dotfiles/herdr/accounts/add-account.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/leolee/Library/Logs/herdr-remod.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/leolee/Library/Logs/herdr-remod.log</string>
</dict>
</plist>
