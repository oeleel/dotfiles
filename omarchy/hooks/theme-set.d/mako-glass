#!/bin/bash
# Regenerate the translucent notification background from the current theme.
bg=$(grep -m1 '^background-color=' ~/.config/omarchy/current/theme/mako.ini | cut -d= -f2)
{
  echo "# Generated by ~/.config/omarchy/hooks/theme-set.d/mako-glass — do not edit."
  echo "background-color=${bg:0:7}BB"
} > ~/.config/mako/glass.ini
omarchy-restart-mako >/dev/null 2>&1 || true
