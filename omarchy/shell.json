{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.spacer",
          "size": 8
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "audio-swap",
          "type": "command",
          "exec": "/home/leo/.local/bin/audio-output-status",
          "interval": 3,
          "onClick": "/home/leo/.local/bin/audio-toggle-output",
          "tooltip": "Toggle audio output: headphones / speakers"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "goodnight",
          "type": "command",
          "exec": "/home/leo/.local/bin/goodnight status",
          "interval": 2,
          "onClick": "/home/leo/.local/bin/goodnight toggle",
          "tooltip": "Goodnight - screens + RGB off, session stays alive"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
