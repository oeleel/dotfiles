;; Audio dropdown panel, opened from the Waybar audio icon (see ~/.local/bin/audio-dropdown)
(defvar output-label "")
(defvar other-label "")
(defvar volume 50)

;; Invisible fullscreen click-catcher: opens beneath any dropdown, clicking it closes all
(defwindow closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (eventbox :class "closer" :onclick "bar-dropdown --close-all"))

(defvar net-info '{"kind":"...","name":"","ip":"—","wifi_on":true}')
(defvar bt-info '{"powered":false,"devices":[]}')

(defwindow network-popup
  :monitor 0
  :geometry (geometry :anchor "top right" :x "8px" :y "34px" :width "300px")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "glass-popup" :orientation "v" :space-evenly false :spacing 10
    (label :halign "start" :text "${net-info.kind}: ${net-info.name}")
    (label :class "dim" :halign "start" :text "IP: ${net-info.ip}")
    (button :class "switch-btn" :onclick "bar-dropdown --wifi-toggle"
      "${net-info.wifi_on ? '󰖪  Turn Wi-Fi off' : '󰖩  Turn Wi-Fi on'}")
    (button :class "switch-btn" :onclick "eww close network-popup; omarchy-launch-wifi"
      "  Open Wi-Fi manager")))

(defwindow bluetooth-popup
  :monitor 0
  :geometry (geometry :anchor "top right" :x "8px" :y "34px" :width "300px")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "glass-popup" :orientation "v" :space-evenly false :spacing 8
    (button :class "switch-btn"
      :onclick "bluetoothctl power ${bt-info.powered ? 'off' : 'on'} >/dev/null; bar-dropdown --refresh bluetooth"
      "${bt-info.powered ? '󰂲  Turn Bluetooth off' : '󰂯  Turn Bluetooth on'}")
    (for dev in {bt-info.devices}
      (button :class "bt-device" :halign "fill"
        :onclick "bluetoothctl ${dev.connected ? 'disconnect' : 'connect'} ${dev.mac} >/dev/null; bar-dropdown --refresh bluetooth"
        "${dev.connected ? '󰂱' : '󰂯'}  ${dev.name}"))
    (button :class "switch-btn" :onclick "eww close bluetooth-popup; omarchy-launch-bluetooth"
      "  Open manager")))

(defwindow calendar-popup
  :monitor 0
  :geometry (geometry :anchor "top center" :y "34px" :width "300px")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "glass-popup"
    (calendar :class "cal")))

(defwindow audio-popup
  :monitor 0
  :geometry (geometry :anchor "top right" :x "8px" :y "34px" :width "280px")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "audio-popup" :orientation "v" :space-evenly false :spacing 10
    (label :class "output-line" :halign "start" :text "Output: ${output-label}")
    (button :class "switch-btn" :onclick "audio-toggle-output && audio-dropdown --refresh"
      "Switch to ${other-label}")
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "vol-icon" :text "󰕾")
      (scale :class "vol-slider" :hexpand true :min 0 :max 101 :round-digits 0 :value volume
             :onchange "pactl set-sink-volume alsa_output.pci-0000_0e_00.6.analog-stereo {}% && eww update volume={}")
      (label :class "vol-percent" :text "${volume}%"))))
