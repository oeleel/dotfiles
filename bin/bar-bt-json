#!/bin/bash
# Bluetooth status as JSON for the eww bluetooth dropdown.
if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
  powered=true
else
  powered=false
fi

devices=$(bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
  [[ -z $mac ]] && continue
  if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
    connected=true
  else
    connected=false
  fi
  jq -n --arg mac "$mac" --arg name "${name:-$mac}" --argjson connected "$connected" \
    '{mac: $mac, name: $name, connected: $connected}'
done | jq -s '.')

jq -n --argjson powered "$powered" --argjson devices "${devices:-[]}" \
  '{powered: $powered, devices: $devices}'
